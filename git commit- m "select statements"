SELECT 'DATABASE CREATED SUCCESSFULLY ' AS Message;

SELECT 'USER_DETAILS' AS TableName, COUNT(*) AS RecordCount FROM USER_DETAILS
UNION ALL SELECT 'EVENTS', COUNT(*) FROM EVENTS
UNION ALL SELECT 'CATEGORIES', COUNT(*) FROM CATEGORIES
UNION ALL SELECT 'ENROLMENT', COUNT(*) FROM ENROLMENT
UNION ALL SELECT 'RESULTS', COUNT(*) FROM RESULTS
UNION ALL SELECT 'PAYMENTS', COUNT(*) FROM PAYMENTS
UNION ALL SELECT 'ROLES', COUNT(*) FROM ROLES
ORDER BY TableName;

-- Show sample data
SELECT 'SAMPLE DATA ' AS Message;

-- Users
SELECT USERID, USER_FULLNAME, USER_EMAIL, USER_ROLE, PHONENUMBER 
FROM USER_DETAILS;

-- Events with Organiser
SELECT e.EVENTID, e.EVENT_NAME, e.EVENT_DATE, e.LOCATION, u.USER_FULLNAME AS ORGANISER
FROM EVENTS e
JOIN USER_DETAILS u ON e.USERID = u.USERID;

-- Enrolments with details
SELECT en.ENROLMENTID, u.USER_FULLNAME AS PARTICIPANT, e.EVENT_NAME, c.CATEGORY_NAME, en.STATUS
FROM ENROLMENT en
JOIN USER_DETAILS u ON en.USERID = u.USERID
JOIN EVENTS e ON en.EVENTID = e.EVENTID
JOIN CATEGORIES c ON en.CATEGORYID = c.CATEGORYID;
